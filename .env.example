# Auth.js(NextAuth) 세션 암호화 키. `npx auth secret`으로 생성 가능
AUTH_SECRET=

# AX Auth(사내 공통 인증 서비스) — 사내 SSO 로그인용. Azure AD와 직접 연동하지 않고
# AX Auth가 로그인을 대행한다(docs/product/login-integration-guide.md 참고)
# AX팀에 등록을 요청해 발급받은 값
AX_AUTH_CLIENT_ID=
AX_AUTH_CLIENT_SECRET=
# 기본값: https://ax-auth.s-food.ai (비워두면 코드 기본값 사용)
AX_AUTH_BASE_URL=
# 본 서비스의 로그인 콜백 URL. AX팀에 redirect_uri로 등록해야 함
# 예: https://{서비스 도메인}/api/auth/ax-callback
AX_AUTH_REDIRECT_URI=

# Confluence Cloud 서비스 계정 — 문서/댓글 저장소 연동용
# 형식: https://{your-domain}.atlassian.net/wiki
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
# Editor가 개인 폴더/문서를 저장할 Confluence Space Key
CONFLUENCE_SPACE_KEY=

# 운영 이상 감지 알림용 Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=
