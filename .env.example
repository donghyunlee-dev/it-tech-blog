# Auth.js(NextAuth) 세션 암호화 키. `npx auth secret`으로 생성 가능
AUTH_SECRET=

# Microsoft Entra ID(Azure AD) 앱 등록 정보 — 사내 SSO 로그인용
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# 형식: https://login.microsoftonline.com/{tenantId}/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Confluence Cloud 서비스 계정 — 문서/댓글 저장소 연동용
# 형식: https://{your-domain}.atlassian.net/wiki
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# 운영 이상 감지 알림용 Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=
