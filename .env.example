# Auth.js(NextAuth) 세션 암호화 키. `npx auth secret`으로 생성 가능
# Viewer는 댓글 작성 시에만 이 세션을 사용한다(전역 로그인 게이트 없음).
AUTH_SECRET=

# AX Auth(사내 공통 인증 서비스) — 댓글 작성 시에만 트리거되는 MS 로그인용.
# Azure AD와 직접 연동하지 않고 AX Auth가 로그인을 대행한다(docs/product/login-integration-guide.md 참고)
# AX팀에 Viewer(댓글 로그인) 전용 clientId로 등록을 요청해 발급받은 값(Editor용 clientId와는 별개)
AX_AUTH_CLIENT_ID=
AX_AUTH_CLIENT_SECRET=
# 기본값: https://ax-auth.s-food.ai (비워두면 코드 기본값 사용)
AX_AUTH_BASE_URL=
# 본 서비스의 로그인 콜백 URL. AX팀에 redirect_uri로 등록해야 함
# 예: https://{Viewer 도메인}/api/auth/ax-callback
AX_AUTH_REDIRECT_URI=

# Confluence Cloud 서비스 계정 — 게시 문서·댓글 조회/저장용(Editor와 동일한 서비스 계정 공유)
# 형식: https://{your-domain}.atlassian.net/wiki
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
# Editor가 문서를 게시하는 Confluence Space Key(Viewer는 이 Space를 읽기 전용으로 조회)
CONFLUENCE_SPACE_KEY=

# 운영 이상 감지 알림용 Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=

# Viewer 공개 서비스의 절대 URL(canonical URL·sitemap.xml·rss.xml 생성용)
# 비워두면 http://localhost:3000을 기본값으로 사용
SITE_BASE_URL=
